generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  email            String            @unique
  passwordHash     String
  role             Role
  verificationStatus VerificationStatus @default(APPROVED)
  isEmailVerified  Boolean           @default(false)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  bloodBankProfile BloodBankProfile?
  donorProfile     DonorProfile?
  hospitalProfile  HospitalProfile?
  notifications    Notification[]

  @@map("users")
}

model DonorProfile {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @unique @db.Uuid
  firstName        String
  lastName         String
  bloodType        BloodType
  dateOfBirth      DateTime
  gender           String?
  lastDonationDate DateTime?
  phone            String

  // Location — full Nepal-style hierarchy
  province         String?
  district         String?
  municipality     String?
  address          String?
  // Legacy flat fields kept for backwards-compat / donor-search queries
  city             String    @default("")
  state            String    @default("")

  // Health details (captured at registration, optional but encouraged)
  weight                   Float?
  donatedBefore            Boolean   @default(false)
  currentlyHealthy         Boolean   @default(true)
  onMedication             Boolean   @default(false)
  medicalConditions        String?

  // Availability & contact preference
  availableToDonate        Boolean   @default(true)
  notificationsEnabled     Boolean   @default(true)
  preferredContactMethod   String    @default("phone")

  // Emergency contact (stored as flat columns — no extra table needed)
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  matchedRequests  BloodRequest[] @relation("MatchedDonorRequests")
  appointments     Appointment[]

  @@map("donor_profiles")
}

model HospitalProfile {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @unique @db.Uuid
  name          String
  licenseNumber String         @unique
  address       String
  contactPerson String
  phone         String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  bloodRequests BloodRequest[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("hospital_profiles")
}

model BloodBankProfile {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @unique @db.Uuid
  name             String
  licenseNumber    String           @unique
  address          String
  contactPerson    String
  phone            String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventory        BloodInventory[]
  matchedRequests  BloodRequest[]   @relation("MatchedBloodBankRequests")
  appointments     Appointment[]

  @@map("blood_bank_profiles")
}

model BloodRequest {
  id                  String            @id @default(uuid()) @db.Uuid
  hospitalId          String            @db.Uuid
  patientName         String
  bloodType           BloodType
  unitsRequired       Int
  urgency             RequestUrgency    @default(NORMAL)
  status              RequestStatus     @default(PENDING)
  requiredByDate      DateTime
  ward                String?
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  hospital            HospitalProfile   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  
  matchedDonorId      String?           @db.Uuid
  matchedDonor        DonorProfile?     @relation("MatchedDonorRequests", fields: [matchedDonorId], references: [id], onDelete: SetNull)
  
  matchedBloodBankId  String?           @db.Uuid
  matchedBloodBank    BloodBankProfile? @relation("MatchedBloodBankRequests", fields: [matchedBloodBankId], references: [id], onDelete: SetNull)
  
  appointments        Appointment[]

  @@map("blood_requests")
}

model BloodInventory {
  id             String           @id @default(uuid()) @db.Uuid
  bloodBankId    String           @db.Uuid
  bloodType      BloodType
  unitsAvailable Int              @default(0)
  unitsReserved  Int              @default(0)
  lastUpdated    DateTime         @updatedAt
  bloodBank      BloodBankProfile @relation(fields: [bloodBankId], references: [id], onDelete: Cascade)

  @@unique([bloodBankId, bloodType])
  @@map("blood_inventories")
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  donorId         String            @db.Uuid
  donor           DonorProfile      @relation(fields: [donorId], references: [id], onDelete: Cascade)
  bloodBankId     String            @db.Uuid
  bloodBank       BloodBankProfile  @relation(fields: [bloodBankId], references: [id], onDelete: Cascade)
  bloodRequestId  String?           @db.Uuid
  bloodRequest    BloodRequest?     @relation(fields: [bloodRequestId], references: [id], onDelete: SetNull)
  appointmentDate DateTime
  slot            String
  status          AppointmentStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("appointments")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

enum Role {
  DONOR
  HOSPITAL
  BLOOD_BANK
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum RequestUrgency {
  NORMAL
  URGENT
  CRITICAL
}

enum RequestStatus {
  PENDING
  MATCHED_INVENTORY
  MATCHED_DONOR
  IN_DELIVERY
  FULFILLED
  CANCELLED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}
