NODE_ENV=test
PORT=5001
API_VERSION=v1

# Used by scripts/test-integration.sh with docker-compose.test.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/lifelink_test
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/lifelink_test

JWT_ACCESS_SECRET=test-access-secret-change-me-1234567890
JWT_REFRESH_SECRET=test-refresh-secret-change-me-1234567890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=test@example.com
SMTP_PASS=test-password
EMAIL_FROM="LifeLink Test <test@example.com>"

BCRYPT_SALT_ROUNDS=4
LOG_LEVEL=error
